# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string — a Neon branch. The pooled (PgBouncer) endpoint
# needs asyncpg's statement cache disabled (already set in app/db/database.py
# via connect_args={"statement_cache_size": 0}) — PgBouncer's transaction
# pooling mode doesn't support asyncpg's prepared-statement caching.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?ssl=require

# JWT signing secret — generate a long random value, e.g. `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Exchange-rate provider (free, key-less)
EXCHANGE_RATE_API_BASE=https://open.er-api.com/v6
EXCHANGE_RATE_CACHE_TTL_HOURS=12
