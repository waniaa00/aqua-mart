# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (Neon in production; local docker-compose Postgres in dev)
DATABASE_URL=postgresql+asyncpg://fishshop:fishshop@localhost:5433/fishshop_dev

# JWT signing secret — generate a long random value, e.g. `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Exchange-rate provider (free, key-less)
EXCHANGE_RATE_API_BASE=https://open.er-api.com/v6
EXCHANGE_RATE_CACHE_TTL_HOURS=12
